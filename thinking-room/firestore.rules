rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each visitor (anonymous sign-in) writes only their own document; everyone can read.
    match /thoughts/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.items is list && request.resource.data.items.size() <= 10;
    }
    match /reports/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys is list && request.resource.data.keys.size() <= 200;
    }
    match /visits/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.days is list && request.resource.data.days.size() <= 60;
    }
    // Hidden stars: edit only from the Firebase console.
    match /moderation/{doc} {
      allow read: if true;
      allow write: if false;
    }
  }
}
